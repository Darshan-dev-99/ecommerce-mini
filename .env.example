# Copy to .env and adjust. Everything is optional locally: with no variables
# set the app boots on SQLite + Django's in-process cache.
#
#   DJANGO_ENV=dev            # dev settings; use "prod" behind a real proxy
#   DJANGO_SECRET_KEY=...     # required when DJANGO_DEBUG=0
#   DJANGO_DEBUG=1
#
# Uncomment the two URLs below to run against the real stack in docker-compose:
# DATABASE_URL=postgres://bazaarnoon:bazaarnoon@localhost:5432/bazaarnoon
# REDIS_URL=redis://localhost:6379/1
#
# In production also set:
#   DJANGO_ALLOW_ALL_HOSTS=0
#   DJANGO_ALLOWED_HOSTS=bazaarnoon.example.com
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://bazaarnoon.example.com

DJANGO_ENV=dev
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOW_ALL_HOSTS=1

# ------------------------------------------------------------- datastores
# DATABASE_URL=postgres://bazaarnoon:bazaarnoon@localhost:5432/bazaarnoon
# REDIS_URL=redis://localhost:6379/1

# ------------------------------------------------------------ cache-aside TTLs (seconds)
CACHE_TTL_PRODUCT_LIST=60
CACHE_TTL_PRODUCT_DETAIL=120
CACHE_TTL_CATEGORIES=300
CACHE_TTL_BRANDS=300
CACHE_TTL_HOME=45
CACHE_TTL_DASHBOARD=20
CACHE_TTL_SUGGEST=120

# ------------------------------------------------------------ India storefront rules
FREE_DELIVERY_THRESHOLD=499
STANDARD_DELIVERY_FEE=49
COD_FEE=49
COD_MAX_ORDER_VALUE=50000
LOW_STOCK_THRESHOLD=5

STORE_LOG_LEVEL=INFO
